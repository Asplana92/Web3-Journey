3. GPU Node (Vast.ai)

Install Tailscale:
   curl -fsSL https://tailscale.com/install.sh | sh
   tailscale up
 
Start llama-server:# Note IP: 100.xxx.xxx.xx
    llama-server \
  --model /workspace/models/qwen2.5-7b-instruct-q6_k.gguf \
  --ctx-size 8192 \
  --n-gpu-layers 99 \
  --host 0.0.0.0 \
  --port 8081 &

Create mlnode_adapter:
   # /workspace/mlnode_adapter.py (simplified)
  from fastapi import FastAPI
  import httpx

  app = FastAPI()

  @app.get("/health")
  async def health():
    return {"status": "ok", "models": ["Qwen/Qwen2.5-7B-Instruct"]}

  @app.post("/v3.0.8/api/v1/infer")
  async def infer(request: dict):
    async with httpx.AsyncClient() as client:
        response = await client.post(
            "http://127.0.0.1:8081/completion",
            json={"prompt": request["prompt"]}
        )
        return {"text": response.json()["content"]}

Run adapter:
   uvicorn mlnode_adapter:app --host 0.0.0.0 --port 8085

Watchdog script:
     cat > /workspace/watchdog.sh << 'EOF'
    #!/bin/bash
   pgrep -f "llama-server"      >/dev/null || /workspace/start-llama.sh &
   pgrep -f "mlnode_adapter.py" >/dev/null || python /workspace/mlnode_adapter.py &
   tailscale status >/dev/null 2>&1 || tailscale up &
   EOF

   chmod +x /workspace/watchdog.sh
   crontab -e  # Add:
   # */5 * * * * /workspace/watchdog.sh



